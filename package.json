{
  "name": "depthfinder",
  "version": "0.1.0",
  "description": "Keep your AI context honest. Zero-config scan of CLAUDE.md / AGENTS.md / .cursorrules against your actual repo — deterministic, no model calls, nothing leaves your machine.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "depthfinder": "bin/depthfinder.mjs"
  },
  "files": [
    "bin/",
    "src/cli/",
    "lib/text.mjs",
    "lib/redact.mjs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phdev/Depthfinder.git"
  },
  "keywords": [
    "ai",
    "context",
    "claude-md",
    "agents-md",
    "cursorrules",
    "lint",
    "agent",
    "context-rot"
  ],
  "scripts": {
    "start": "node server.mjs",
    "map": "node scripts/context-map.mjs",
    "tokens": "node scripts/token-budget.mjs",
    "coverage": "node scripts/coverage.mjs",
    "drift:refresh": "node scripts/drift-refresh.mjs",
    "test": "node --test",
    "bench": "node scripts/bench.mjs",
    "corpus": "node scripts/corpus.mjs",
    "corpus:docs": "node scripts/doc-corpus.mjs",
    "corpus:burn": "node scripts/burn-corpus.mjs",
    "snapshot:update": "node tests/helpers/update-golden.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
